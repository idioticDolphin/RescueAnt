starting_url_file = "starting_urls.csv";
database = "crawl.db";

politeness = 5;
skip_tags = "script", "style", "noscript", "svg", "iframe", "form";

categories = STATION|LIST|IRRELEVANT;
category_prompt = "Respond with a categorization of the following website as a website listing animal rescue stations, the website of an animal rescue station and irrelevant others. Only answer with the category, the categories are mutually exclusive.";
category_max_tokens = 20;
category_model_path = "/home/johannes/PycharmProjects/RescueAnt/models/Qwen3.5-4B-UD-Q4_K_XL.gguf";
category_context = 4096;

relevancy[STATION] = True;
prompt[STATION] = "Extract the following fields from this animal rescue station website as JSON. Leave out fields you cannot fill with the provided information.";
max_tokens[STATION] = 40;
context[STATION] = 4096;
model_path[STATION] = "/home/johannes/PycharmProjects/RescueAnt/models/Qwen3.5-4B-UD-Q4_K_XL.gguf";
check_linked_urls[STATION] = True;
is_list_category[STATION] = False;

relevancy[LIST] = True;
prompt[LIST] = "Extract the following fields from this animal rescue station website as JSON. Leave out fields you cannot fill with the provided information.";
max_tokens[LIST] = 30;
context[LIST] = 4096;
model_path[LIST] = "/home/johannes/PycharmProjects/RescueAnt/models/Qwen3.5-4B-UD-Q4_K_XL.gguf";
check_linked_urls[LIST] = True;
is_list_category[LIST] = True;

relevancy[IRRELEVANT] = False;

fields = {"station_url": "string",
    "name": "string",
    "address": "string",
    "e-mail": "string",
    "telephone": "string",
    "mobile": "string",
    "accepted_animals": "list[animal_type]",
    "description": "string"
    };

define animal_type = MAMMAL|REPTILE|BIRD;