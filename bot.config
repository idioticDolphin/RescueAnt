starting_url_file = "starting_urls.csv";
database = "crawl.db";

discover_urls = True;
    search_provider = "Google";
    search_query_file = "search_queries.csv";
    search_api_key = "";
    search_engine_id = "";
    search_timeout = 10.0;
    results_per_query = 10;
    query_politeness = 1.0;

politeness = 5;
skip_tags = "script", "style", "noscript", "svg", "iframe", "form";
redo_all_fetches = False;
redo_failed_fetches = True;

categories = STATION|LIST|IRRELEVANT;
category_prompt = "Respond with a categorization of the following website as a website listing animal rescue stations, the website of an animal rescue station and irrelevant others. Only answer with the category, the categories are mutually exclusive.";
category_max_tokens = 20;
category_model_path = "models/Qwen3.5-4B-UD-Q4_K_XL.gguf";
category_context = 8192;

relevancy[STATION] = True;
prompt[STATION] = "Extract the following fields from this animal rescue station website as JSON. Leave out fields you cannot fill with the provided information. Animal_pickup is the question whether the stations pick up animals on site.";
max_tokens[STATION] = 400;
context[STATION] = 8192;
model_path[STATION] = "models/Qwen3.5-4B-UD-Q4_K_XL.gguf";
check_linked_urls[STATION] = True;
is_list_category[STATION] = False;

relevancy[LIST] = True;
prompt[LIST] = "Extract the following fields from this animal rescue station website as JSON. Leave out fields you cannot fill with the provided information. Animal_pickup is the question whether the stations pick up animals on site.";
max_tokens[LIST] = 3000;
context[LIST] = 8192;
model_path[LIST] = "models/Qwen3.5-4B-UD-Q4_K_XL.gguf";
check_linked_urls[LIST] = True;
is_list_category[LIST] = True;

relevancy[IRRELEVANT] = False;

fields = {"station_url": "string",
    "name": "string",
    "address": "string",
    "country": "string",
    "e-mail": "string",
    "telephone": "string",
    "mobile": "string",
    "emergency_telephone": "string",
    "social_media": "string",
    "accepted_animals": "list[string]",
    "service_area": "string",
    "animal_pickup": "boolean",
    "opening_hours": "string",
    "description": "string"
    };

define animal_type = mammal|bat|rodent|carnivore|ungulate|hedgehog|lagomorph|marine_mammal|primate|marsupial|bird|bird_of_prey|owl|songbird|waterbird|seabird|reptile|turtle|snake|lizard|crocodilian|amphibian|frog|salamander|fish|invertebrate;