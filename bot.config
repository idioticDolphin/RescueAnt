include "config/schema.config";
include "config/lexicon/multilingual.config";
starting_url_file = "starting_urls.csv";
database = "crawl.db";

# Google deprecated whole-web search in the free Custom Search API tier, so
# discovery here uses a self-hosted SearXNG instance instead (free, no API
# key). Run `docker compose up -d` to start it - see the README's "Search
# engines" section for setup details.
discover_urls = True;
    search_provider = "SearXNG";
    search_query_file = "search_queries.csv";
    search_base_url = "http://localhost:8080/search";
    query_parameters = "q";
    search_result_path = "results";
    search_url_field = "url";
    search_extra_params = {"format": "json"};
    search_headers = {};
    search_timeout = 10.0;
    results_per_query = 10;
    query_politeness = 1.0;

politeness = 5;

# Pages matching url_tokens[exclude] are routed here instead of costing an
# extraction call. HUB is links-only, so their outbound links are still followed.
url_prior_category = "HUB";
# Fetched page bodies are kept here so a run can be resumed, and so extraction
# can be re-run without re-crawling.
page_store_path = "store";
# Discourages the degenerate repetition that used to run generation to the
# context limit.
repeat_penalty = 1.1;
# Backstop against generation that has stalled, not against generation that is
# legitimately long. A flat 120s cap was tried first and was a clear
# regression: it cut *every* LIST extraction, taking one listing page from 19
# records to 5. The budget therefore scales with the tokens a category may
# produce - 120s floor for a 400-token record, 1600s for an 8000-token listing
# - which is still bounded, since max_tokens bounds the work absolutely.
# Measured throughput on this machine is ~6.7 tokens/s; 5 leaves margin.
llm_call_timeout_seconds = 120;
min_generation_tokens_per_second = 5;
# Remove lines recurring across a site's pages before classifying/extracting.
# This is what stops an operator's header/footer identity block from making
# every subpage look like its own entity. No-op until a site has enough
# stored pages to tell chrome from content.
strip_site_boilerplate = True;
boilerplate_min_pages = 4;
boilerplate_threshold = 0.6;
# Fetching is orders of magnitude faster than analysis, so an uncapped round
# fetches thousands of pages and then grinds through them one at a time.
# Capping the round keeps extracted output roughly in step with crawling.
max_batch_size = 60;
# One site must not absorb the whole crawl: an unbudgeted run spent 424 of
# 527 fetched pages on a single pet-supplies retailer, for one usable record.
max_pages_per_site = 40;
# A site that has already given up its details three times has nothing left to
# give. The classifier cannot be relied on to notice: it is inconsistent about
# which subpages introduce an organisation (on one site /geldspenden came back
# STATION while /sachspenden came back HUB), and sites were producing twenty
# records that resolved to a single entity. Three attempts still covers the
# homepage, a contact page and a legal-notice page. Listing pages are exempt,
# since each yields different entities. Worth 33% of all extraction calls in
# the run that motivated it.
max_extractions_per_site = 3;
# Frontier ordering: a link found on a page that itself listed stations is a
# far better bet than one found on an unrelated page. Without this the crawl
# diffuses into the general web once the seed listings are exhausted.
referrer_weights = {"LIST": 6.0, "STATION": 4.0, "HUB": 1.0, "COMMERCIAL": -10.0, "IRRELEVANT": -4.0};
# Search hits answer the configured queries directly, so they outrank links.
discovery_priority = 50.0;
# Reach for discovery once nothing promising is left, rather than waiting for
# a literally empty queue - with link-following into the open web, the queue
# never empties and discovery would never run again.
discovery_when_below = 0.5;
# "nav" is dropped structurally because cross-page boilerplate learning cannot
# help the first pages of a site: with fewer than ~5 pages stored, a site's
# menu survives into the cleaned text and dominates it, and a page whose text
# is mostly a menu of links reads as a directory. Categorisation accuracy on
# subpages tracked stored-page count almost monotonically before this.
# Link discovery is unaffected - extract_links() parses the raw HTML.
# header/footer are deliberately kept: that is where an organisation's own
# address and phone number usually live.
skip_tags = "script", "style", "noscript", "svg", "iframe", "form", "nav";
redo_all_fetches = False;
redo_failed_fetches = True;

# orchestrator.run() only pulls in search-engine discovery once the fetch
# queue (starting URLs, plus links found while crawling) has fully run dry.
# When that happens, it runs this many of the generated queries and queues
# whatever they find, instead of running every query at once - that would
# burn through the whole search API quota in one go for no benefit.
discovery_batch_size = 5;
# Stopping parameters for orchestrator.run() - the full crawl workflow stops
# once any of these is hit (0 means "no limit" for that parameter). The
# workflow always also stops on its own once the fetch queue is empty AND
# there are no more discovery queries left to try.
max_discovery_batches = 0;
max_rounds = 0;
max_runtime_seconds = 0;

categories = STATION|LIST|HUB|COMMERCIAL|IRRELEVANT;
# Three failure modes observed in the 2026-09-16 run drove this wording:
#   - Every subpage of a shelter site was called STATION, because a site-wide
#     footer satisfies "shows that station's contact details". One shelter
#     cost 19 extraction calls to yield a single entity. STATION is now the
#     organisation's *main* information page only; the rest are HUB.
#   - Pages listing the wrong kind of thing were called LIST purely for being
#     lists (a cat-food catalogue, Google's office locations, a Brazilian
#     government agency index). LIST now names what the entries must be.
#   - Commercial pet sites had no bucket that felt right, so they landed in
#     LIST/HUB and their links were followed: one dog-services app absorbed
#     2.7 of one run's 3.3 hours. COMMERCIAL gives them a home, and a
#     strongly negative referrer weight keeps the crawl out of them.
category_prompt = "Categorize the website below into exactly one of the given categories. The subject of interest is animal rescue: organisations that take in, treat, shelter or rehome animals in need, such as animal shelters, wildlife rescue and rehabilitation centres, sanctuaries and animal welfare associations. STATION means introducing this organisation is the main purpose of this page - typically its homepage, 'about us', 'contact' or legal-notice page. Most pages of a rescue organisation's website repeat its name, address and phone number in a header or footer; that alone never makes a page STATION. Ask what the page is *for*: if its subject is anything other than the organisation itself, it is HUB. HUB means this page belongs to a relevant site but is not that main information page - for example a subpage about job openings, news, events, donations, volunteering, or animals offered for adoption, lost or found - or it is a landing, navigation or index page of an umbrella body or directory that is likely to link to STATION or LIST pages elsewhere. LIST means this page itself shows the details of several different animal rescue organisations at once, such as a directory, overview or regional listing of them. The listed entries must be rescue organisations themselves: a page listing individual animals, pets offered for adoption, lost or found animals, products, shops, breeds, places, commercial services or unrelated businesses is not a LIST, however many entries it shows. COMMERCIAL means the page's purpose is selling or promoting goods or services, or it is a commercial platform, marketplace, app or brand site; pet shops, pet-supply retailers, product catalogues, breeders and commercial pet apps belong here even when they mention animals, shelters or adoption. IRRELEVANT means the page has nothing to do with animal rescue and is unlikely to link to anything relevant either. Only answer with the category name, the categories are mutually exclusive.";
category_max_tokens = 20;
category_model_path = "models/Qwen3.5-4B-UD-Q4_K_XL.gguf";
category_context = 32768;

relevancy[STATION] = CONTENT;
prompt[STATION] = "Extract the following fields from this animal rescue station website as JSON. Leave out fields you cannot fill with the provided information. Animal_pickup is the question whether the stations pick up animals on site.";
max_tokens[STATION] = 400;
context[STATION] = 32768;
model_path[STATION] = "models/Qwen3.5-4B-UD-Q4_K_XL.gguf";
check_linked_urls[STATION] = True;
is_list_category[STATION] = False;

relevancy[LIST] = CONTENT;
prompt[LIST] = "Extract the following fields from this animal rescue station website as JSON. Leave out fields you cannot fill with the provided information. Animal_pickup is the question whether the stations pick up animals on site.";
max_tokens[LIST] = 8000;
context[LIST] = 32768;
model_path[LIST] = "models/Qwen3.5-4B-UD-Q4_K_XL.gguf";
check_linked_urls[LIST] = True;
is_list_category[LIST] = True;

# HUB pages have no station/list content of their own (an umbrella
# organization's homepage, or a directory site's landing/navigation page
# that likely links to STATION or LIST pages elsewhere on the site) - so
# there's nothing to extract and no prompt/model/fields are configured for
# it, but its outbound links are still worth following.
relevancy[HUB] = LINKS;
check_linked_urls[HUB] = True;

# Commercial pet sites are the crawl's main diffusion attractor: they are
# densely interlinked, animal-themed enough to look plausible, and endless.
# Nothing is extracted from them and their links are not followed.
relevancy[COMMERCIAL] = IRRELEVANT;

relevancy[IRRELEVANT] = IRRELEVANT;


define animal_type = mammal|bat|rodent|carnivore|ungulate|hedgehog|lagomorph|marine_mammal|primate|marsupial|bird|bird_of_prey|owl|songbird|waterbird|seabird|reptile|turtle|snake|lizard|crocodilian|amphibian|frog|salamander|fish|invertebrate;