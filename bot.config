categories = STATION|LIST|IRRELEVANT;
category_prompt = "Respond with a categorization into STATION, LIST and IRRELEVANT for the following website, where STATION signifies a website of an animal rescue station, LIST a website that lists those stations and IRRELEVANT everything else. Only answer with the category, the categories are mutually exclusive.";
category_max_tokens = 20;
category_model_path = "models/Qwen3.5-4B-UD-Q4_K_XL.gguf";

relevancy[STATION] = True;
prompt[STATION] = "Extract the following fields from the listed animal rescue stations as JSON. Leave out fields you cannot fill with the provided information. accepted_animals should be a list of animals out of the provided animal options. description should only be filled, if there is a description present for the station. linked_urls should be a list of urls listed on the website, not linking one of the stations.";
max_tokens[STATION] = 40;
model_path[STATION] = "models/Qwen3.5-4B-UD-Q4_K_XL.gguf";
check_linked_urls[STATION] = True;

relevancy[LIST] = True;
prompt[LIST] = "Extract the following fields from this animal rescue station website as JSON. Leave out fields you cannot fill with the provided information. accepted_animals should be a list of animals out of the provided animal options. description should only be filled, if there is a description present for the station. linked_urls should be a list of urls listed on the website. station_url should be left empty.";
max_tokens[LIST] = 30;
model_path[LIST] = "models/Qwen3.5-4B-UD-Q4_K_XL.gguf";
check_linked_urls[LIST] = True;

relevancy[IRRELEVANT] = False;

fields = {"station_url": "string",
    "name": "string",
    "address": "string",
    "e-mail": "string",
    "telephone": "string",
    "mobile": "string",
    "accepted_animals": "list[animal_type]",
    "description": "string",
    "linked_urls": "list"
    };

define animal_type = MAMMAL|REPTILE|BIRD;