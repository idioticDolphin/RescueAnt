include "config/schema.config";
include "config/taxonomy.config";
include "config/lexicon/multilingual.config";
# One file or several. Keeping seeds in themed sets lets a deployment add its
# own list without editing anyone else's. starting_urls_other.csv carries the
# regional directories and species-specific networks; a handful of its entries
# are Google Maps and Facebook links, which the domain denylist declines - that
# is the denylist doing its job, not a missing seed.
starting_url_file = "starting_urls.csv", "starting_urls_other.csv";
database = "crawl.db";

# Google deprecated whole-web search in the free Custom Search API tier, so
# discovery here uses a self-hosted SearXNG instance instead (free, no API
# key). Run `docker compose up -d` to start it - see the README's "Search
# engines" section for setup details.
discover_urls = True;
    search_provider = "SearXNG";
    search_query_file = "search_queries.csv";
    search_base_url = "http://localhost:8080/search";
    query_parameters = "q";
    search_result_path = "results";
    search_url_field = "url";
    search_extra_params = {"format": "json"};
    search_headers = {};
    search_timeout = 10.0;
    results_per_query = 10;
    query_politeness = 1.0;

politeness = 5;

# Pages matching url_tokens[exclude] are routed here instead of costing an
# extraction call. HUB is links-only, so their outbound links are still followed.
url_prior_category = "HUB";
# Fetched page bodies are kept here so a run can be resumed, and so extraction
# can be re-run without re-crawling.
page_store_path = "store";
# Discourages the degenerate repetition that used to run generation to the
# context limit.
repeat_penalty = 1.1;
# Backstop against generation that has stalled, not against generation that is
# legitimately long. A flat 120s cap was tried first and was a clear
# regression: it cut *every* LIST extraction, taking one listing page from 19
# records to 5. The budget therefore scales with the tokens a category may
# produce - 120s floor for a 400-token record, 1600s for an 8000-token listing
# - which is still bounded, since max_tokens bounds the work absolutely.
# Measured throughput on this machine is ~6.7 tokens/s; 5 leaves margin.
llm_call_timeout_seconds = 120;
min_generation_tokens_per_second = 5;
# Remove lines recurring across a site's pages before classifying/extracting.
# This is what stops an operator's header/footer identity block from making
# every subpage look like its own entity. No-op until a site has enough
# stored pages to tell chrome from content.
strip_site_boilerplate = True;
boilerplate_min_pages = 4;
boilerplate_threshold = 0.6;
# Fetching is orders of magnitude faster than analysis, so an uncapped round
# fetches thousands of pages and then grinds through them one at a time.
# Capping the round keeps extracted output roughly in step with crawling.
max_batch_size = 60;
# Fetch the next batch while this one is analysed. Measured over three rounds
# of a live crawl: 6.3 s per page against 4.7 s, a quarter faster. The cost is
# that the next batch is chosen before this batch's links are known.
prefetch_next_batch = True;
# A deadline for one page's whole fetch, not just its navigation: a wedged
# browser page once blocked an overnight run for eleven hours, its own process
# spinning while the crawler waited on it.
fetch_timeout_seconds = 90;
# One site must not absorb the whole crawl: an unbudgeted run spent 424 of
# 527 fetched pages on a single pet-supplies retailer, for one usable record.
max_pages_per_site = 40;
# ...but a site should not need its whole budget to show it holds nothing.
# Five pages at or below the weight threshold (AUTHORITY, ANIMAL, COMMERCIAL,
# IRRELEVANT under the default taxonomy) with no record extracted, and the
# site is dropped. Replayed against a 1,000-page crawl this saved 8% of
# fetches - nih.gov alone took 39 - for two pages of doubtful value.
abandon_site_after = 5;
abandon_site_max_weight = 0.5;
# Links to files are skipped before fetching: a browser starts a download
# instead of rendering them, so each one cost a failed navigation.
skip_url_extensions = ".pdf", ".doc", ".docx", ".xls", ".xlsx", ".ppt", ".pptx",
    ".odt", ".ods", ".zip", ".rar", ".7z", ".jpg", ".jpeg", ".png", ".gif", ".webp",
    ".svg", ".mp3", ".mp4", ".mov", ".avi", ".ics", ".vcf", ".exe", ".dmg", ".apk";
# A site that has already given up its details three times has nothing left to
# give. The classifier cannot be relied on to notice: it is inconsistent about
# which subpages introduce an organisation (on one site /geldspenden came back
# STATION while /sachspenden came back HUB), and sites were producing twenty
# records that resolved to a single entity. Three attempts still covers the
# homepage, a contact page and a legal-notice page. Listing pages are exempt,
# since each yields different entities. Worth 33% of all extraction calls in
# the run that motivated it.
max_extractions_per_site = 3;
discovery_priority = 50.0;
# Reach for discovery once nothing promising is left, rather than waiting for
# a literally empty queue - with link-following into the open web, the queue
# never empties and discovery would never run again.
discovery_when_below = 0.5;
# "nav" is dropped structurally because cross-page boilerplate learning cannot
# help the first pages of a site: with fewer than ~5 pages stored, a site's
# menu survives into the cleaned text and dominates it, and a page whose text
# is mostly a menu of links reads as a directory. Categorisation accuracy on
# subpages tracked stored-page count almost monotonically before this.
# Link discovery is unaffected - extract_links() parses the raw HTML.
# header/footer are deliberately kept: that is where an organisation's own
# address and phone number usually live.
skip_tags = "script", "style", "noscript", "svg", "iframe", "form", "nav";
redo_all_fetches = False;
redo_failed_fetches = True;

# orchestrator.run() only pulls in search-engine discovery once the fetch
# queue (starting URLs, plus links found while crawling) has fully run dry.
# When that happens, it runs this many of the generated queries and queues
# whatever they find, instead of running every query at once - that would
# burn through the whole search API quota in one go for no benefit.
discovery_batch_size = 5;
# Stopping parameters for orchestrator.run() - the full crawl workflow stops
# once any of these is hit (0 means "no limit" for that parameter). The
# workflow always also stops on its own once the fetch queue is empty AND
# there are no more discovery queries left to try.
max_discovery_batches = 0;
max_rounds = 0;
max_runtime_seconds = 0;



define animal_type = mammal|bat|rodent|carnivore|ungulate|hedgehog|lagomorph|marine_mammal|primate|marsupial|bird|bird_of_prey|owl|songbird|waterbird|seabird|reptile|turtle|snake|lizard|crocodilian|amphibian|frog|salamander|fish|invertebrate;

# Development only. Serve pages already in the page store instead of fetching
# them again - no request reaches the site, not even for robots.txt, and a round
# served entirely from disk never starts a browser. A crawl run this way cannot
# see anything that changed since the page was stored, which is exactly what
# makes it reproducible for development and wrong for building a real directory.
# Seed the index from earlier crawl databases with:
#   python src/main.py bot.config --index-store crawl.db other.db
reuse_stored_pages = False;
# 0 means a stored page is reusable however old it is.
reuse_max_age_days = 0;
