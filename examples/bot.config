# Small example configuration, meant to sanity-check the full workflow end
# to end (fetch -> categorize -> extract -> discover) against a couple of
# real URLs/queries without touching your "real" bot.config, database, or
# starting_urls/search_queries files.
#
# Run it from the project root with:
#   python src/main.py examples/bot.config
#
# It still needs the model downloaded (./download-models.sh) and, if you
# want to actually exercise search-based discovery, real search_api_key /
# search_engine_id values below - see the README's "Search engines" section
# for how to get those (or how to swap in a different provider entirely).

starting_url_file = "examples/starting_urls.csv";
database = "examples/example_crawl.db";

discover_urls = True;
    search_provider = "Google";
    search_query_file = "examples/search_queries.csv";
    search_api_key = "";
    search_engine_id = "";
    search_timeout = 10.0;
    results_per_query = 5;
    query_politeness = 1.0;

politeness = 5;
skip_tags = "script", "style", "noscript", "svg", "iframe", "form";
redo_all_fetches = False;
redo_failed_fetches = True;

# Keep an example run short and cheap: at most 2 queries per discovery
# batch, at most 1 discovery batch, at most 3 fetch/process batches overall.
discovery_batch_size = 2;
max_discovery_batches = 1;
max_rounds = 3;
max_runtime_seconds = 0;

categories = STATION|IRRELEVANT;
category_prompt = "Respond with a categorization of the following website as a website listing animal rescue stations, the website of an animal rescue station and irrelevant others. Only answer with the category, the categories are mutually exclusive.";
category_max_tokens = 20;
category_model_path = "models/Qwen3.5-4B-UD-Q4_K_XL.gguf";
category_context = 8192;

relevancy[STATION] = True;
prompt[STATION] = "Extract the following fields from this animal rescue station website as JSON. Leave out fields you cannot fill with the provided information.";
max_tokens[STATION] = 400;
context[STATION] = 8192;
model_path[STATION] = "models/Qwen3.5-4B-UD-Q4_K_XL.gguf";
check_linked_urls[STATION] = True;
is_list_category[STATION] = False;

relevancy[IRRELEVANT] = False;

fields = {"station_url": "string",
    "name": "string",
    "address": "string",
    "e-mail": "string",
    "telephone": "string"
    };
