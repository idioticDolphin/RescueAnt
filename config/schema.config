# Extraction schema and field semantics.
#
# `fields` declares what to extract. The `field[...]` entries declare what each
# field *means*, in domain-neutral terms, and everything downstream is driven
# by those declarations rather than by field names:
#
#   role      identifier - near-unique; agreement strongly implies a match
#             locator    - places the entity; corroborates, and disagreement
#                          counts against a match
#             label      - a human name; supporting evidence only, never
#                          decisive on its own (generic names are common)
#             attribute  - descriptive payload, used only when fusing
#   weight    contribution to the match score for this field
#   normalize comparison normalizer (email / phone / url / digits / casefold)
#   fusion    how to combine this field across a cluster of records
#
# Swapping this file (and the prompts) retargets the crawler at an entirely
# different kind of entity without any code change.

fields = {"station_url": "string",
    "name": "string",
    "address": "string",
    "country": "string",
    "e-mail": "string",
    "telephone": "string",
    "mobile": "string",
    "emergency_telephone": "string",
    "social_media": "string",
    "accepted_animals": "list[string]",
    "service_area": "string",
    "animal_pickup": "boolean",
    "opening_hours": "string",
    "description": "string"
    };

field[name]                = {"role": "label", "weight": 0.3, "fusion": "trust_then_mode"};
field[e-mail]              = {"role": "identifier", "weight": 1.0, "normalize": "email", "fusion": "union"};
field[telephone]           = {"role": "identifier", "weight": 0.9, "normalize": "phone", "fusion": "union"};
field[mobile]              = {"role": "identifier", "weight": 0.9, "normalize": "phone", "fusion": "union"};
field[station_url]         = {"role": "identifier", "weight": 0.8, "normalize": "url", "fusion": "union"};
field[address]             = {"role": "locator", "weight": 0.7, "fusion": "trust_then_valid"};
field[service_area]        = {"role": "attribute", "fusion": "trust_then_mode"};
field[country]             = {"role": "attribute", "fusion": "trust_then_mode"};
field[emergency_telephone] = {"role": "attribute", "normalize": "phone", "fusion": "first_by_trust"};
field[social_media]        = {"role": "attribute", "fusion": "union"};
field[accepted_animals]    = {"role": "attribute", "fusion": "union"};
field[animal_pickup]       = {"role": "attribute", "fusion": "or_with_evidence"};
field[opening_hours]       = {"role": "attribute", "fusion": "longest_from_top_trust"};
field[description]         = {"role": "attribute", "fusion": "longest_from_top_trust"};

# A record must be nameable and must carry at least one field that either
# identifies or locates it - otherwise it is site boilerplate, not an entity.
require_fields   = "name";
require_any_role = "identifier", "locator";
