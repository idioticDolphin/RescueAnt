# Locale pack: URL path tokens, by purpose.
#
# These are the only language-bound values the crawler needs; keeping them in
# a pack means a deployment in another language swaps this file instead of
# touching code. Tokens are matched against casefolded URL *path* segments.
#
# exclude : the page's own content is not worth extracting from. Such pages
#           are routed to url_prior_category (a links-only category), so
#           their outbound links are still followed.
# identity: the page is likely to carry the operator's own contact details.
#           Note that a token can appear in both lists - a German Impressum
#           is useless as an entity page but is the best identity source on
#           the site, because German law requires it to carry the operator's
#           name, address and phone number.

url_tokens[exclude] = "datenschutz", "impressum", "agb", "presse", "spenden",
    "shop", "warenkorb", "jobs", "karriere", "galerie", "bilder", "termine",
    "veranstaltungen", "newsletter", "suche", "login", "anmelden", "cookie",
    "sitemap", "quiz", "patenschaften", "geschenkideen", "mitglied",
    "privacy", "terms", "press", "donate", "cart", "checkout", "gallery",
    "events", "search", "signin", "register", "imprint", "legal", "sponsor";

url_tokens[identity] = "kontakt", "impressum", "ueber-uns", "wir-ueber-uns",
    "anfahrt", "standort", "adresse", "about", "contact", "imprint",
    "find-us", "location", "reach-us";

# Query parameters that never change which page is returned.
drop_query_params = "rch", "ref", "src", "from", "cmplz";

# Domains that are never crawl targets: search engines, social networks and
# consent/CDN infrastructure. Reached constantly via links from real pages,
# and never themselves an entity. Deployment-specific, hence configuration.
domain_denylist = "google.com", "google.de", "g.co", "googleusercontent.com",
    "bing.com", "duckduckgo.com", "yahoo.com", "baidu.com", "yandex.com",
    "facebook.com", "instagram.com", "twitter.com", "x.com", "linkedin.com",
    "youtube.com", "youtu.be", "pinterest.com", "pinterest.de", "tiktok.com",
    "whatsapp.com", "telegram.org", "xing.com", "reddit.com",
    "europa.eu", "cookiebot.com", "cookielaw.org", "usercentrics.com",
    "borlabs.io", "gstatic.com", "gravatar.com", "wordpress.org",
    "amazon.de", "amazon.com", "ebay.de", "paypal.com", "fressnapf.de",
    "apple.com", "microsoft.com", "adobe.com", "wikipedia.org";
