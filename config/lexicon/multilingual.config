# Locale pack: URL path tokens, by purpose.
#
# These are the only language-bound values the crawler needs; keeping them in
# a pack means a deployment in another language swaps this file instead of
# touching code. Tokens are matched against casefolded URL *path* segments.
#
# exclude : the page's own content is not worth extracting from. Such pages
#           are routed to url_prior_category (a links-only category), so
#           their outbound links are still followed.
# identity: the page is likely to carry the operator's own contact details.
#           Note that a token can appear in both lists - a German Impressum
#           is useless as an entity page but is the best identity source on
#           the site, because German law requires it to carry the operator's
#           name, address and phone number.

url_tokens[exclude] = "datenschutz", "impressum", "agb", "presse", "spenden",
    "shop", "warenkorb", "jobs", "karriere", "galerie", "bilder", "termine",
    "veranstaltungen", "newsletter", "suche", "login", "anmelden", "cookie",
    "sitemap", "quiz", "patenschaften", "geschenkideen", "mitglied",
    "privacy", "terms", "press", "donate", "cart", "checkout", "gallery",
    "events", "search", "signin", "register", "imprint", "legal", "sponsor";

url_tokens[identity] = "kontakt", "impressum", "ueber-uns", "wir-ueber-uns",
    "anfahrt", "standort", "adresse", "about", "contact", "imprint",
    "find-us", "location", "reach-us";

# Query parameters that never change which page is returned.
drop_query_params = "rch", "ref", "src", "from", "cmplz";

# Domains that are never crawl targets: search engines, social networks and
# consent/CDN infrastructure. Reached constantly via links from real pages,
# and never themselves an entity. Deployment-specific, hence configuration.
# The last eight entries were added after auditing fetch failures: 38 of 131
# failed fetches went to share widgets, consent infrastructure and social
# platforms that cannot hold a target. s2f.kytta.dev alone accounted for 20 -
# it is a "share to fediverse" button, so every page carrying one offered a
# link to it.
domain_denylist = "google.com", "google.de", "g.co", "googleusercontent.com",
    "bing.com", "duckduckgo.com", "yahoo.com", "baidu.com", "yandex.com",
    "facebook.com", "instagram.com", "twitter.com", "x.com", "linkedin.com",
    "youtube.com", "youtu.be", "pinterest.com", "pinterest.de", "tiktok.com",
    "whatsapp.com", "telegram.org", "xing.com", "reddit.com",
    "europa.eu", "cookiebot.com", "cookielaw.org", "usercentrics.com",
    "borlabs.io", "gstatic.com", "gravatar.com", "wordpress.org",
    "amazon.de", "amazon.com", "ebay.de", "paypal.com", "fressnapf.de",
    "apple.com", "microsoft.com", "adobe.com", "wikipedia.org",
    "kytta.dev", "cookiedatabase.org", "threads.net", "bsky.app",
    "mastodon.social", "addtoany.com", "sharethis.com";

# Fawn-rescue groups are not stations, but call themselves wildlife rescues and
# are listed alongside them. Their names and domains say what they are in any
# language the crawl meets; the model does not reliably read it. On labelled
# data: 41 of 63 fawn-rescue pages caught by host, 10 records by name, and no
# station lost to either rule.
category_host_tokens[FAWN] = "kitz", "faon";

# Listings mix stations with what a station database does not want, and the
# entry's own name usually says which. Measured on 300 judged records: these
# remove 34 non-stations and 8 doubtful ones, and cost one real station - a
# fawn-rescue group judged under an older scope. A single filtering call per
# listing page did worse on the same records, whichever way it was worded.
exclude_record_name_tokens = "kitz", "faon", "tierheim", "tierschutzverein",
    "tierschutzhof", "tierklinik", "tierarzt", "kleintierzentrum", "veterinaria",
    "veterinario", "veterinary", "clinica veterinaria", "zoo", "tierpark",
    "wildpark", "vogelpark", "falknerei",
    "auffangstationen und pflegestellen", "tierkliniken/";

# ...unless the name also says the entry cares for animals: "Igelpflegestation
# Walter Zoo" is a hedgehog station that happens to sit inside a zoo.
keep_record_name_tokens = "pflegestation", "auffangstation", "wildtierstation",
    "wildtierhilfe", "wildvogel", "igelstation", "igelpflege", "wildlife refuge",
    "rehabilitation", "rescue centre", "rescue center";

# A listing with no name for an entry often writes how to reach it instead, and
# the extractor copies that faithfully: five French rescue centres arrived as
# "Contact : DHORNE". The prefix comes off; what follows is the best name the
# page offers.
label_prefixes_to_strip = "contact", "kontakt", "ansprechpartner", "ansprechpartnerin",
    "contacto", "contatto";
