# Page taxonomy: what kinds of page exist, which are worth extracting from,
# and which are worth following links out of.
#
# Swapping this file (with config/schema.config) retargets the crawler at a
# different kind of entity without touching any code.
#
# Every category here earns its place from an observed misclassification. The
# governing lesson from two sessions of tuning: a model puts a page in the
# bucket that *fits* it, so the way to stop a page landing in the wrong bucket
# is to offer it a right one, not to write a longer prohibition. Pet-supply
# catalogues stopped being classified LIST the moment COMMERCIAL existed;
# nothing in the LIST wording had to change.
#
# Cases that drove each addition:
#   ANIMAL      one sanctuary's per-resident pages came back STATION, LIST,
#               HUB, IRRELEVANT *and* COMMERCIAL - essentially at random - and
#               seven individual animals ended up in the database as rescue
#               stations. They are pages about an animal, so give them that.
#   SHELTER     a pet shelter rehomes domestic animals; it is not a wildlife
#               rescue station, and conflating them makes the output unusable
#               for either purpose.
#   SANCTUARY   lifetime care without rehoming is a third thing again.
#   VET         clinics appear both as emergency contacts on rescue listings
#               and as ordinary businesses; worth keeping, worth labelling.
#   ADVICE      "what to do if you find an injured bird" pages are link-rich
#               towards actual stations, which is why they score high.
#   ADVOCACY    two political parties and three conservation foundations were
#               extracted as rescue stations. They are about animals, so
#               IRRELEVANT never felt right to the model.
#   AUTHORITY   a federal ministry and two hunting associations, likewise.

categories = STATION|SHELTER|SANCTUARY|VET|LIST|ADVICE|ANIMAL|ADVOCACY|AUTHORITY|HUB|COMMERCIAL|IRRELEVANT;

category_prompt = "Categorize the page below into exactly one of the given categories. The subject of interest is organisations that take in, treat, shelter, rehabilitate or rehome animals in need. First decide what the page is *for*; only then choose. Most pages of an organisation's website repeat its name, address and phone number in a header or footer, and that alone never decides anything. STATION means introducing a wildlife rescue or rehabilitation organisation is the main purpose of this page - a centre that takes in injured or orphaned wild animals to treat and release them - typically its homepage, 'about us', 'contact' or legal-notice page. SHELTER means the same, but for an organisation whose work is housing and rehoming domestic or companion animals, such as an animal shelter or a rehoming society. SANCTUARY means the same, but for a place that gives animals permanent lifetime care and does not rehome them. VET means the page introduces a veterinary practice, clinic or animal hospital. LIST means this page itself shows the details of several different such organisations at once, such as a directory, overview or regional listing of them; the listed entries must be organisations, so a page listing individual animals, products, shops, breeds or places is not a LIST however many entries it shows. ADVICE means the page's purpose is telling the reader what to do about an animal in trouble - first aid, emergency instructions, who to call, how to report a find - rather than introducing an organisation. Many organisations open their own homepage with such guidance; if the page also introduces the organisation that provides the help, choose that organisation's category instead. ANIMAL means the page is about one or more individual animals: a profile of an animal offered for adoption or living at a sanctuary, a lost or found notice, a memorial, or a gallery of such profiles. A page on an organisation's own site showing the animals it currently has - its adoption listing, its residents, its lost-and-found - is ANIMAL, not that organisation: the page is about the animals, and the organisation is merely who hosts them. ADVOCACY means the organisation campaigns, lobbies, funds or raises awareness - a political party, a conservation foundation, a welfare association - without itself taking animals in. AUTHORITY means the page belongs to a government body, ministry, public agency, or an official professional or hunting association. HUB means the page belongs to a relevant site but is none of the above - a subpage about job openings, news, events, donations or volunteering, or a landing, navigation or index page likely to link onwards to the kinds of page above. COMMERCIAL means the page's purpose is selling or promoting goods or services, or it is a commercial platform, marketplace, app or brand site; pet shops, pet-supply retailers, product catalogues, breeders and commercial pet apps belong here even when they mention animals, shelters or adoption. IRRELEVANT means the page has nothing to do with animals and is unlikely to link to anything relevant either. Only answer with the category name, the categories are mutually exclusive.";
category_max_tokens = 20;
category_model_path = "models/Qwen3.5-4B-UD-Q4_K_XL.gguf";
category_context = 32768;

# --- categories worth extracting records from -------------------------------
# All four share one schema, so they land in one table and are told apart by
# the category recorded on their crawl row. A consumer wanting only wildlife
# rescue filters on STATION; one building a directory keeps all four.

relevancy[STATION] = CONTENT;
prompt[STATION] = "Extract the following fields about this wildlife rescue or rehabilitation organisation as JSON. Use only what the page states; leave out fields you cannot fill. Animal_pickup is whether they collect animals themselves rather than only receiving them.";
max_tokens[STATION] = 400;
context[STATION] = 32768;
model_path[STATION] = "models/Qwen3.5-4B-UD-Q4_K_XL.gguf";
check_linked_urls[STATION] = True;
is_list_category[STATION] = False;

relevancy[SHELTER] = CONTENT;
prompt[SHELTER] = "Extract the following fields about this animal shelter or rehoming organisation as JSON. Use only what the page states; leave out fields you cannot fill. Animal_pickup is whether they collect animals themselves rather than only receiving them.";
max_tokens[SHELTER] = 400;
context[SHELTER] = 32768;
model_path[SHELTER] = "models/Qwen3.5-4B-UD-Q4_K_XL.gguf";
check_linked_urls[SHELTER] = True;
is_list_category[SHELTER] = False;

relevancy[SANCTUARY] = CONTENT;
prompt[SANCTUARY] = "Extract the following fields about this animal sanctuary as JSON. Use only what the page states; leave out fields you cannot fill. Animal_pickup is whether they collect animals themselves rather than only receiving them.";
max_tokens[SANCTUARY] = 400;
context[SANCTUARY] = 32768;
model_path[SANCTUARY] = "models/Qwen3.5-4B-UD-Q4_K_XL.gguf";
check_linked_urls[SANCTUARY] = True;
is_list_category[SANCTUARY] = False;

relevancy[VET] = CONTENT;
prompt[VET] = "Extract the following fields about this veterinary practice or clinic as JSON. Use only what the page states; leave out fields you cannot fill. Animal_pickup is whether they collect animals themselves rather than only receiving them.";
max_tokens[VET] = 400;
context[VET] = 32768;
model_path[VET] = "models/Qwen3.5-4B-UD-Q4_K_XL.gguf";
check_linked_urls[VET] = True;
is_list_category[VET] = False;

relevancy[LIST] = CONTENT;
prompt[LIST] = "This page lists several organisations that take in, shelter or treat animals. Extract one JSON record per organisation listed. Use only what the page states; leave out fields you cannot fill. Do not invent entries, and do not create a record for an individual animal, a place name or a section heading.";
max_tokens[LIST] = 8000;
context[LIST] = 32768;
model_path[LIST] = "models/Qwen3.5-4B-UD-Q4_K_XL.gguf";
check_linked_urls[LIST] = True;
is_list_category[LIST] = True;

# --- categories worth following, but with nothing of their own to extract ---

# Emergency-guidance pages are the densest source of links to real stations,
# which is why they outrank an ordinary hub by a wide margin.
relevancy[ADVICE] = LINKS;
check_linked_urls[ADVICE] = True;

# A page about individual animals belongs to an organisation worth finding,
# but says nothing about that organisation - and mining it produced records
# named after dogs.
relevancy[ANIMAL] = LINKS;
check_linked_urls[ANIMAL] = True;

relevancy[ADVOCACY] = LINKS;
check_linked_urls[ADVOCACY] = True;

relevancy[AUTHORITY] = LINKS;
check_linked_urls[AUTHORITY] = True;

relevancy[HUB] = LINKS;
check_linked_urls[HUB] = True;

# --- dead ends --------------------------------------------------------------

# Commercial pet sites are the crawl's main diffusion attractor: densely
# interlinked, animal-themed enough to look plausible, and endless.
relevancy[COMMERCIAL] = IRRELEVANT;

relevancy[IRRELEVANT] = IRRELEVANT;

# Links inherit a score from the page that offered them. ADVICE outranks even
# STATION: a first-aid page exists to send the reader to a station, so its
# links are the most likely to be one.
referrer_weights = {"LIST": 6.0, "ADVICE": 5.0, "STATION": 4.0, "SHELTER": 3.0,
                    "SANCTUARY": 3.0, "VET": 2.0, "HUB": 1.0, "ADVOCACY": 1.0,
                    "AUTHORITY": 0.5, "ANIMAL": 0.5,
                    "COMMERCIAL": -10.0, "IRRELEVANT": -4.0};
