# Page taxonomy: what kinds of page exist, which are worth extracting from,
# and which are worth following links out of.
#
# Swapping this file (with config/schema.config) retargets the crawler at a
# different kind of entity without touching any code.
#
# Every category here earns its place from an observed misclassification. The
# governing lesson from two sessions of tuning: a model puts a page in the
# bucket that *fits* it, so the way to stop a page landing in the wrong bucket
# is to offer it a right one, not to write a longer prohibition. Pet-supply
# catalogues stopped being classified LIST the moment COMMERCIAL existed;
# nothing in the LIST wording had to change.
#
# Cases that drove each addition:
#   ANIMAL      one sanctuary's per-resident pages came back STATION, LIST,
#               HUB, IRRELEVANT *and* COMMERCIAL - essentially at random - and
#               seven individual animals ended up in the database as rescue
#               stations. They are pages about an animal, so give them that.
#   SHELTER     a pet shelter rehomes domestic animals; it is not a wildlife
#               rescue station, and conflating them makes the output unusable
#               for either purpose.
#   SANCTUARY   lifetime care without rehoming is a third thing again.
#   VET         clinics appear both as emergency contacts on rescue listings
#               and as ordinary businesses; worth keeping, worth labelling.
#   ADVICE      "what to do if you find an injured bird" pages are link-rich
#               towards actual stations, which is why they score high.
#   ADVOCACY    two political parties and three conservation foundations were
#               extracted as rescue stations. They are about animals, so
#               IRRELEVANT never felt right to the model.
#   AUTHORITY   a federal ministry and two hunting associations, likewise.
#   DIRECTORY   directories of shelters, fawn-rescue groups, microchipping vets,
#               student guidance centres and certified charities were all
#               classified LIST, polluting the database by the dozen per page.
#               A clause saying such lists are not LIST changed nothing; a
#               category they fit did.
#   FAWN        fawn-rescue groups search meadows with drones before mowing and
#               call themselves wildlife rescues, but take no animals into care.
#               Listed by the hundred on directory sites, they made up a third
#               of all records until they had a category of their own.
#
# The database holds wildlife rescue stations only. SHELTER, SANCTUARY, VET and
# FAWN are still classified - a page needs somewhere right to go, and their
# links are followed - but they produce no records.

categories = STATION|SHELTER|SANCTUARY|VET|FAWN|LIST|DIRECTORY|ADVICE|ANIMAL|ADVOCACY|AUTHORITY|HUB|COMMERCIAL|IRRELEVANT;

category_prompt = "Categorize the page below into exactly one of the given categories. The subject of interest is organisations that take in, treat, shelter, rehabilitate or rehome animals in need. First decide what the page is *for*; only then choose. Most pages of an organisation's website repeat its name, address and phone number in a header or footer, and that alone never decides anything. STATION means introducing a wildlife rescue or rehabilitation organisation is the main purpose of this page - a centre that takes in injured or orphaned wild animals to treat and release them - typically its homepage, 'about us', 'contact' or legal-notice page. Hedgehog, squirrel, bat and wild bird care stations are STATION, including private carers. SHELTER means the same, but for an organisation whose work is housing and rehoming domestic or companion animals, such as an animal shelter or a rehoming society. SANCTUARY means the same, but for a place that gives animals permanent lifetime care and does not rehome them. VET means the page introduces a veterinary practice, clinic or animal hospital. FAWN means the page introduces a group that searches fields for fawns or other young wild animals before mowing - usually with drones or dogs - and carries them out of harm's way rather than taking animals into care; such a group belongs here even when it calls itself a wildlife rescue. LIST means this page itself shows the details of several different wildlife rescue stations at once, such as a directory, overview or regional listing of them. The entries must be mostly stations that take in wild animals; a page listing individual animals, products, shops, breeds or places is not a LIST however many entries it shows. DIRECTORY means the page shows the details of several organisations of any other kind - animal shelters, vets, fawn-rescue groups, lost-pet offices, clubs, schools, charities, businesses - whether or not they concern animals. ADVICE means the page's purpose is telling the reader what to do about an animal in trouble - first aid, emergency instructions, who to call, how to report a find - rather than introducing an organisation. A rescue organisation's own home page is almost never ADVICE, however much guidance it leads with: helping the reader act is what such an organisation is for, and its front page saying so is still the organisation introducing itself. Choose ADVICE only when the page gives guidance without being the front page of the organisation behind it - a subpage of advice, or a page on a site that belongs to someone else. The URL is given above the content; a bare domain with no path is a front page. ANIMAL means the page is about one or more individual animals: a profile of an animal offered for adoption or living at a sanctuary, a lost or found notice, a memorial, or a gallery of such profiles. A page on an organisation's own site showing the animals it currently has - its adoption listing, its residents, its lost-and-found - is ANIMAL, not that organisation: the page is about the animals, and the organisation is merely who hosts them. ADVOCACY means the organisation campaigns, lobbies, funds or raises awareness - a political party, a conservation foundation, a welfare association - without itself taking animals in. AUTHORITY means the page belongs to a government body, ministry, public agency, or an official professional or hunting association. HUB means the page belongs to a relevant site but is none of the above - a subpage about job openings, news, events, donations or volunteering, or a landing, navigation or index page likely to link onwards to the kinds of page above. COMMERCIAL means the page's purpose is selling or promoting goods or services, or it is a commercial platform, marketplace, app or brand site; pet shops, pet-supply retailers, product catalogues, breeders and commercial pet apps belong here even when they mention animals, shelters or adoption. IRRELEVANT means the page has nothing to do with animals and is unlikely to link to anything relevant either. Only answer with the category name, the categories are mutually exclusive.";
category_max_tokens = 20;
category_model_path = "models/Qwen3.5-4B-UD-Q4_K_XL.gguf";
category_context = 32768;

# --- categories worth extracting records from -------------------------------

relevancy[STATION] = CONTENT;
prompt[STATION] = "Extract the following fields about this wildlife rescue or rehabilitation organisation as JSON. Use only what the page states; leave out fields you cannot fill. Animal_pickup is whether they collect animals themselves rather than only receiving them. Copy every value in the language and wording the page uses; never translate it or add a paraphrase in another language.";
max_tokens[STATION] = 400;
context[STATION] = 32768;
model_path[STATION] = "models/Qwen3.5-4B-UD-Q4_K_XL.gguf";
check_linked_urls[STATION] = True;
is_list_category[STATION] = False;

relevancy[LIST] = CONTENT;
# Asking this prompt to skip entries that are not stations does not work: on
# a fawn-rescue directory it kept 60 of 69 entries, on a shelter directory 16
# of 17, and on a mixed wildlife listing it dropped real stations while
# keeping a shelter. Keeping non-station listings out is DIRECTORY's job.
prompt[LIST] = "This page lists several organisations that take in, shelter or treat animals. Extract one JSON record per organisation listed. Use only what the page states; leave out fields you cannot fill. Do not invent entries, and do not create a record for an individual animal, a place name or a section heading. Copy every value in the language and wording the page uses; never translate it or add a paraphrase in another language.";
max_tokens[LIST] = 8000;
context[LIST] = 32768;
model_path[LIST] = "models/Qwen3.5-4B-UD-Q4_K_XL.gguf";
check_linked_urls[LIST] = True;
is_list_category[LIST] = True;

# A directory of fawn-rescue groups or animal shelters is a list, so it lands
# in LIST however LIST is described - and each such page put dozens of records
# that are not stations into the database. Asked separately what most of the
# entries are, the model tells them apart. Two findings shaped the wording:
# the accepted answer must be offered LAST (offered first, it was chosen for
# 18 of 31 pages that were not station lists; last, for 2), and the local
# names for fawn rescue and shelters must be given (without them a raptor
# centre's list of 78 rescue centres was rejected as fawn rescue).
# Measured on 58 labelled listing pages: 55 right, one station list rejected.
confirm_prompt[LIST] = "Look at the entries this page lists and say what most of them are. fawn-rescue: groups or drone pilots that search meadows for fawns before mowing (Kitzrettung, Rehkitzrettung, Kitzretter, sauvetage des faons). animal-shelters: shelters and rehoming societies for pets (Tierheim, Tierschutzverein, refuge). vets: veterinary practices and clinics. other: anything else. wildlife-stations: places that take in and care for injured or orphaned wild animals, such as wildlife rescue centres, bird, hedgehog, squirrel or bat care stations and private wildlife carers.";
confirm_answers[LIST] = fawn-rescue|animal-shelters|vets|other|wildlife-stations;
confirm_accept[LIST] = wildlife-stations;
confirm_fallback[LIST] = DIRECTORY;

# --- categories worth following, but with nothing of their own to extract ---

# Not stations. Give them CONTENT and a prompt[...] like STATION's to extract
# them as well; they share its schema.
relevancy[SHELTER] = LINKS;
check_linked_urls[SHELTER] = True;
relevancy[SANCTUARY] = LINKS;
check_linked_urls[SANCTUARY] = True;
relevancy[VET] = LINKS;
check_linked_urls[VET] = True;

# A directory of other organisations rarely links to a station, but a
# shelter or vet directory occasionally does.
relevancy[DIRECTORY] = LINKS;
check_linked_urls[DIRECTORY] = True;

# Fawn-rescue sites link mostly to each other and to drone vendors.
relevancy[FAWN] = LINKS;
check_linked_urls[FAWN] = True;

# Emergency-guidance pages are the densest source of links to real stations,
# which is why they outrank an ordinary hub by a wide margin.
relevancy[ADVICE] = LINKS;
check_linked_urls[ADVICE] = True;

# A page about individual animals belongs to an organisation worth finding,
# but says nothing about that organisation - and mining it produced records
# named after dogs.
relevancy[ANIMAL] = LINKS;
check_linked_urls[ANIMAL] = True;

relevancy[ADVOCACY] = LINKS;
check_linked_urls[ADVOCACY] = True;

relevancy[AUTHORITY] = LINKS;
check_linked_urls[AUTHORITY] = True;

relevancy[HUB] = LINKS;
check_linked_urls[HUB] = True;

# --- dead ends --------------------------------------------------------------

# Commercial pet sites are the crawl's main diffusion attractor: densely
# interlinked, animal-themed enough to look plausible, and endless.
relevancy[COMMERCIAL] = IRRELEVANT;

relevancy[IRRELEVANT] = IRRELEVANT;

# Links inherit a score from the page that offered them. ADVICE outranks even
# STATION: a first-aid page exists to send the reader to a station, so its
# links are the most likely to be one.
referrer_weights = {"LIST": 6.0, "ADVICE": 5.0, "STATION": 4.0, "VET": 2.0,
                    "SHELTER": 1.5, "SANCTUARY": 1.5, "HUB": 1.0, "ADVOCACY": 1.0,
                    "AUTHORITY": 0.5, "ANIMAL": 0.5, "FAWN": 0.5, "DIRECTORY": 0.5,
                    "COMMERCIAL": -10.0, "IRRELEVANT": -4.0};

# --- extraction's second opinion ----------------------------------------------
# The extractor sees the whole page under instructions describing exactly what
# a record of this category is - far more than the classifier had. With this
# on, it may answer {"mislabeled": true} instead of a record, which costs a few
# tokens where a full extraction costs tens of seconds. The page is re-filed
# under mislabeled_category, its links are followed with that category's
# weight, and the original classification is kept in reclassified_from.
#
# Off by default. A wrongly rejected page is a lost record, which is worse than
# the call the verdict saves. On 50 labelled pages it caught 24 of 31
# misclassified pages and rejected 1 of 19 real ones; most of the pages it let
# through were subpages of real organisations, whose records deduplicate
# into the organisation anyway. Measure it on your own pages with
# experiments/mislabel_verdict_benchmark.py before turning it on.
# mislabel_instruction overrides the wording of the verdict instruction.
mislabel_check = False;
mislabeled_category = "HUB";
